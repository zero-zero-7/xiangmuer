# 数据库连接串：mysql://用户名:密码@主机:端口/库名
# 用 启动四序颐养-本地版.bat 启动时会自动切到 SQLite，无需填写
DATABASE_URL=mysql://root:你的密码@127.0.0.1:3306/siyu

# 微信登录配置（测试号申请地址）：
# https://mp.weixin.qq.com/debug/cgi-bin/sandbox?t=sandbox/login
WECHAT_APPID=
WECHAT_APPSECRET=
# mp=公众号网页授权（默认，测试号用这个）；open=开放平台网站应用扫码登录
WECHAT_MODE=mp
# 授权回调地址，必须与微信后台配置的域名一致，例如：
# WECHAT_REDIRECT_URI=https://你的域名/api/auth/wechat/callback
WECHAT_REDIRECT_URI=
WECHAT_SCOPE=snsapi_userinfo
